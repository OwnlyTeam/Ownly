<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ownly.Views.Pages.PowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,42,48,40" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="12">
                <Button Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="0,0,0,2"
                        HorizontalAlignment="Left" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                        <TextBlock Text="Back" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="POWER MODES" FontSize="12" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <TextBlock Text="Tune the balance for how you use your PC." FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                <TextBlock Text="Ownly changes only the active Windows power scheme. Every switch is logged with the previous scheme so it can be restored." FontSize="16" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" MaxWidth="720" />
                <Border Background="#20242A" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,14">
                    <TextBlock Text="REVERSIBLE · WINDOWS POWERCFG · MODERATE RISK" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="#BFC4CC" />
                </Border>
                <TextBlock x:Name="ActiveText" Text="Reading active power mode..." FontSize="15" Foreground="{StaticResource OwnlyTextBrush}" Margin="0,2,0,12" />
                <StackPanel x:Name="ModesPanel" Spacing="12" />
                <TextBlock x:Name="FeedbackText" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
