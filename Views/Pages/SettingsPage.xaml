<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ownly.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,42,48,40" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="12">
                <TextBlock Text="SETTINGS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <TextBlock Text="Make Ownly yours." FontSize="38" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                <TextBlock Text="Preferences will be saved here as Ownly grows." FontSize="16" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <Border Style="{StaticResource OwnlyCardStyle}" Padding="22" Margin="0,22,0,0">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Advanced controls" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                            <TextBlock Text="Unlock deeper Windows configuration options when they are ready." Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch IsOn="False" IsEnabled="False" OffContent="OFF" OnContent="ON" HorizontalAlignment="Right" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource OwnlyCardStyle}" Padding="22">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Safety first" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                        <TextBlock Text="Ownly will always explain a change, show its risk, and provide a restore path before applying it." Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
