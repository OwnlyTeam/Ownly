<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ownly.Views.Pages.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,42,48,48" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="0">
                <TextBlock x:Name="EyebrowText" Style="{StaticResource OwnlyEyebrowStyle}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource OwnlyDisplayTitleStyle}" Margin="0,10,0,8" />
                <TextBlock x:Name="DescriptionText" MaxWidth="720" TextWrapping="Wrap" FontSize="15"
                           LineHeight="23" Foreground="{StaticResource OwnlyMutedTextBrush}" />

                <StackPanel x:Name="ContentStack" Spacing="14" Margin="0,28,0,0" />

                <TextBlock x:Name="FeedbackText" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}"
                           Margin="0,18,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
