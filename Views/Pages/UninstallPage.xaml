<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ownly.Views.Pages.UninstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,42,48,40" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="12">
                <Button Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="0,0,0,2"
                        HorizontalAlignment="Left" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                        <TextBlock Text="Back" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="UNINSTALL PROGRAMS" FontSize="12" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <TextBlock Text="See what's installed. Remove what you don't want." FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Ownly reads the same list Windows' own &quot;Apps &amp; features&quot; uses, then hands off to each program's own uninstaller — it does not delete files itself. After an uninstall, Ownly checks for anything left behind." FontSize="15" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" MaxWidth="720" />
                <Border Background="#20242A" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left" Margin="0,4,0,10">
                    <TextBlock Text="RUNS THE VENDOR'S OWN UNINSTALLER · NOT REVERSIBLE" FontSize="10" FontWeight="SemiBold" CharacterSpacing="70" Foreground="#BFC4CC" />
                </Border>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search installed programs…" TextChanged="SearchBox_TextChanged" />
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="REFRESH" Click="Refresh_Click" />
                </Grid>

                <TextBlock x:Name="StatusText" Text="Reading installed programs..." FontSize="14" Foreground="{StaticResource OwnlyMutedTextBrush}" Margin="0,2,0,0" />
                <StackPanel x:Name="AppsPanel" Spacing="10">
                    <ProgressRing IsActive="True" Width="28" Height="28" />
                </StackPanel>
                <TextBlock x:Name="FeedbackText" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
