<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ownly.Views.Pages.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,42,48,40" MaxWidth="1080" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="CLEAN" FontSize="12" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <TextBlock Text="A clearer PC starts with a clear picture." FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" Margin="0,10,0,8" />
                <TextBlock Text="Ownly will look for safe, explainable recommendations before it ever offers an action." FontSize="16" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource OwnlyCardStyle}" Padding="28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="BLOATWARE CLEANUP" FontSize="12" FontWeight="SemiBold" CharacterSpacing="110" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                        <TextBlock x:Name="StatusText" Text="Remove what you don't want." FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                        <TextBlock x:Name="SummaryText" Text="Ownly will identify optional apps, ads, and background clutter before anything can be removed." FontSize="14" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" MaxWidth="620" />
                    </StackPanel>
                    <Button x:Name="ScanButton" Grid.Column="1" Content="SCAN FOR BLOATWARE" Click="ScanButton_Click" Padding="24,13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4">
                <TextBlock Text="OPTIONAL CONTROLS" Style="{StaticResource OwnlySectionTitleStyle}" />
                <TextBlock Text="Smaller choices related to cleanup. Each one stays independent from the main review." FontSize="14" Foreground="{StaticResource OwnlyMutedTextBrush}" Margin="0,6,0,18" />
                <Grid ColumnSpacing="12" Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource OwnlyCardStyle}" Padding="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Windows suggestions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                            <TextBlock Text="Review tips, recommendations, and promotional surfaces." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                            <TextBlock x:Name="SuggestionsStatus" Text="OPTIONAL · REVERSIBLE" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                            <Button x:Name="SuggestionsButton" Content="LIMIT SUGGESTIONS" Click="SuggestionsButton_Click" HorizontalAlignment="Left" Padding="12,8" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource OwnlyCardStyle}" Padding="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Background apps" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                            <TextBlock Text="Review apps that may keep running when you are not using them." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                            <TextBlock x:Name="BackgroundStatus" Text="OPTIONAL · MODERATE" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                            <Button x:Name="BackgroundButton" Content="LIMIT BACKGROUND APPS" Click="BackgroundButton_Click" HorizontalAlignment="Left" Padding="12,8" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource OwnlyCardStyle}" Padding="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Temporary files" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                            <TextBlock Text="Move eligible temp files into an Ownly backup instead of deleting them." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                            <TextBlock x:Name="TempStatus" Text="SCAN FIRST · RESTORABLE" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                            <Button x:Name="TempButton" Content="SCAN FIRST" IsEnabled="False" Click="TempButton_Click" HorizontalAlignment="Left" Padding="12,8" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="SCAN RESULTS" Style="{StaticResource OwnlySectionTitleStyle}" />
                    <TextBlock x:Name="ResultCountText" Text="NOT SCANNED" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" CharacterSpacing="90" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                </Grid>
                <StackPanel x:Name="ResultsPanel" Spacing="12">
                    <Border Style="{StaticResource OwnlyCardStyle}" Padding="22">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Run a scan to see what Ownly finds." FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                            <TextBlock Text="The first scanner only reads information and does not make changes." Foreground="{StaticResource OwnlyMutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
