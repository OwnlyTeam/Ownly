<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Ownly.Views.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48,42,48,40" MaxWidth="1000" HorizontalAlignment="Left">
            <StackPanel Spacing="12">
                <Button Click="Back_Click" Background="Transparent" BorderThickness="0" Padding="0,0,0,2"
                        HorizontalAlignment="Left" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                        <TextBlock Text="Back" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="STARTUP MANAGER" FontSize="12" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <TextBlock Text="Choose what starts with Windows." FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource OwnlyTextBrush}" />
                <TextBlock Text="Ownly only manages entries in your personal Startup folder. Each item is moved to a private backup so it can be restored." FontSize="16" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" MaxWidth="700" />
                <Border Background="#20242A" CornerRadius="5" Padding="10,6" HorizontalAlignment="Left" Margin="0,8,0,14">
                    <TextBlock Text="REVERSIBLE · USER-ONLY · NO SERVICES TOUCHED" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" Foreground="#BFC4CC" />
                </Border>
                <TextBlock x:Name="StatusText" Text="Reading startup entries..." FontSize="14" Foreground="{StaticResource OwnlyMutedTextBrush}" />
                <StackPanel x:Name="StartupItemsPanel" Spacing="12">
                    <ProgressRing IsActive="True" Width="28" Height="28" />
                </StackPanel>
                <TextBlock x:Name="FeedbackText" FontSize="13" Foreground="{StaticResource OwnlyMutedTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
