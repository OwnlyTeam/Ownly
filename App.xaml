<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Ownly.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ownly"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== Ownly palette : black / white / gray ===== -->
            <Color x:Key="OwnlyBackgroundColor">#000000</Color>
            <Color x:Key="OwnlySurfaceColor">#0C0C0D</Color>
            <Color x:Key="OwnlySurfaceRaisedColor">#161617</Color>
            <Color x:Key="OwnlySurfaceHoverColor">#1E1E20</Color>
            <Color x:Key="OwnlyBorderColor">#242426</Color>
            <Color x:Key="OwnlyBorderStrongColor">#38383B</Color>
            <Color x:Key="OwnlyTextColor">#FFFFFF</Color>
            <Color x:Key="OwnlyMutedTextColor">#8B8B8F</Color>
            <Color x:Key="OwnlyFaintTextColor">#5A5A5E</Color>
            <Color x:Key="OwnlyAccentColor">#FFFFFF</Color>
            <Color x:Key="OwnlyAccentHoverColor">#D4D4D6</Color>
            <Color x:Key="OwnlyAccentDeepColor">#A8A8AC</Color>
            <Color x:Key="OwnlySuccessColor">#E6E6E8</Color>
            <Color x:Key="OwnlyWarningColor">#F5C044</Color>
            <Color x:Key="OwnlyDangerColor">#F06A6A</Color>

            <SolidColorBrush x:Key="OwnlyBackgroundBrush" Color="{StaticResource OwnlyBackgroundColor}" />
            <SolidColorBrush x:Key="OwnlySurfaceBrush" Color="{StaticResource OwnlySurfaceColor}" />
            <SolidColorBrush x:Key="OwnlySurfaceRaisedBrush" Color="{StaticResource OwnlySurfaceRaisedColor}" />
            <SolidColorBrush x:Key="OwnlySurfaceHoverBrush" Color="{StaticResource OwnlySurfaceHoverColor}" />
            <SolidColorBrush x:Key="OwnlyBorderBrush" Color="{StaticResource OwnlyBorderColor}" />
            <SolidColorBrush x:Key="OwnlyBorderStrongBrush" Color="{StaticResource OwnlyBorderStrongColor}" />
            <SolidColorBrush x:Key="OwnlyTextBrush" Color="{StaticResource OwnlyTextColor}" />
            <SolidColorBrush x:Key="OwnlyMutedTextBrush" Color="{StaticResource OwnlyMutedTextColor}" />
            <SolidColorBrush x:Key="OwnlyFaintTextBrush" Color="{StaticResource OwnlyFaintTextColor}" />
            <SolidColorBrush x:Key="OwnlyAccentBrush" Color="{StaticResource OwnlyAccentColor}" />
            <SolidColorBrush x:Key="OwnlyAccentHoverBrush" Color="{StaticResource OwnlyAccentHoverColor}" />
            <SolidColorBrush x:Key="OwnlySuccessBrush" Color="{StaticResource OwnlySuccessColor}" />
            <SolidColorBrush x:Key="OwnlyWarningBrush" Color="{StaticResource OwnlyWarningColor}" />
            <SolidColorBrush x:Key="OwnlyDangerBrush" Color="{StaticResource OwnlyDangerColor}" />

            <LinearGradientBrush x:Key="OwnlyBrandBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFFFF" Offset="0" />
                <GradientStop Color="#9A9A9E" Offset="1" />
            </LinearGradientBrush>

            <!-- WinUI accent controls (ToggleSwitch, focus, ProgressRing) follow the white accent -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource OwnlyAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource OwnlyAccentHoverColor}" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource OwnlyAccentDeepColor}" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3A3A3C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#111111" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource OwnlyAccentColor}" />

            <x:Double x:Key="OwnlyPageMarginLeft">48</x:Double>

            <!-- ===== Shared styles ===== -->
            <Style x:Key="OwnlyCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource OwnlySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OwnlyBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="OwnlyRaisedCardStyle" TargetType="Border" BasedOn="{StaticResource OwnlyCardStyle}">
                <Setter Property="Background" Value="{StaticResource OwnlySurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OwnlyBorderStrongBrush}" />
            </Style>

            <Style x:Key="OwnlySectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OwnlyTextBrush}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="OwnlyEyebrowStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OwnlyMutedTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="150" />
            </Style>

            <Style x:Key="OwnlyDisplayTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource OwnlyTextBrush}" />
                <Setter Property="FontSize" Value="38" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Implicit button styling: applies everywhere, including code-created buttons -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OwnlySurfaceRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OwnlyTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource OwnlyBorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="50" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="OwnlyPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource OwnlyAccentBrush}" />
                <Setter Property="Foreground" Value="#000000" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,11" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="50" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
